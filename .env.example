# Copy to .env.local for local dev. All NEXT_PUBLIC_* values are shipped to the
# browser; never put secrets behind a NEXT_PUBLIC_ prefix.

# --- Supabase ---
# Server-side reads (used in middleware.ts, lib/supabase/server.ts, admin client).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Service role key — bypasses RLS. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Client-side reads (lib/supabase/client.ts, AuthProvider.tsx). Must be the
# same project/key as the server-side values above.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Backend API ---
# Render-hosted Express backend. Server-side reads; client-side reads the
# NEXT_PUBLIC_ version separately.
BACKEND_URL=https://onlyworks-backend-server.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://onlyworks-backend-server.onrender.com

# --- Public app URL ---
# Used for Stripe redirects, share links, OpenGraph metadata, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (optional for most local dev) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Resend (optional for most local dev) ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=OnlyWorks <onboarding@resend.dev>

# --- ONLYWEIRD hackathon registration ---
# HMAC secret for the email-verification-code cookies. Optional: falls back
# to SUPABASE_SERVICE_ROLE_KEY when unset.
# HACKATHON_CODE_SECRET=any-long-random-string

REPLICATE_API_TOKEN=